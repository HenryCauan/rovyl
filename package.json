{
  "name": "zenith-radial-menu",
  "private": true,
  "version": "1.0.0",
  "main": "backend/electron-main.js",
  "author": "Seu Nome",
  "description": "Menu Radial Zenith",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/verify-radial-windowing.mjs && node scripts/generate-win-icon.mjs",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development node scripts/launch-electron.js",
    "start": "node scripts/start-local-runtime.cjs",
    "start:runtime": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "dist": "npm run build && node scripts/run-electron-builder.mjs",
    "test:win32-launch": "node --test backend/win32-launch.test.cjs",
    "test:persistence-shape": "node scripts/persistence-normalize-smoke.mjs",
    "verify:radial-windowing": "node scripts/verify-radial-windowing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tailwindcss/vite": "^4.3.0",
    "active-win": "^8.2.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "node-global-key-listener": "^0.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^4.0.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.1",
    "wait-on": "^7.1.0"
  },
  "build": {
    "appId": "com.seu.zenith",
    "productName": "Zenith OS",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "backend/**/*",
      "resources/bin/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "backend/*.ps1",
      "resources/bin/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/active-win/**/*"
    ],
    "directories": {
      "output": "build-out"
    },
    "afterPack": "./scripts/after-pack-win-icon.cjs",
    "afterAllArtifactBuild": "./scripts/after-all-artifact-win-icon.cjs",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "guid": "5e135f2a-7b3b-4e12-8c14-998822334455",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "include": "nsis/installer.nsh",
      "deleteAppDataOnUninstall": true
    }
  }
}

# Copy to `.env` or `.env.local` in the project root (same folder as package.json).
# Carregado pelo processo principal em `npm start` e no build — não precisa de `npm run build` para testar.
# Never commit real secrets.
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).

GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Desempenho / GPU (Windows) — só se o PC ou outros browsers ficarem lentos com o Zenith aberto ---
# ZENITH_AGGRESSIVE_GPU=1
# ZENITH_DISABLE_HARDWARE_ACCELERATION=1
# ZENITH_MOUSE_HOOK_DELAY_MS=0
